package paquete;

public class Chofer {
	protected String nombre;
	protected Categoria categoria;
	protected Vehiculo vehiculoAsignado=null;
	
	public Chofer(String nombre, Categoria categoria) {
		this.nombre = nombre;
		this.categoria = categoria;
	}
	
	public void asignarVehiculo(Vehiculo v) {
		if (v!= null)
			if (v.aceptoChofer(this))
				vehiculoAsignado=v;
	}
	
	public void desvincularVehiculo() {
		this.vehiculoAsignado = null;
	}

	public String getNombre() {
		return nombre;
	}

	public Categoria getCategoria() {
		return categoria;
	}

	public Vehiculo getVehiculoAsignado() {
		return vehiculoAsignado;
	}

	@Override
	public String toString() {
	    String infoVehiculo = (vehiculoAsignado != null) 
	            ? "Interno #" + vehiculoAsignado.getNumeroInterno() + " (" + vehiculoAsignado.getModelo() + ")" 
	            : "Sin vehículo asignado";
	    return "Chofer: " + nombre + " | " + categoria.getNombreCategoria() + " | Asignación: " + infoVehiculo;
	}
	
	
}
