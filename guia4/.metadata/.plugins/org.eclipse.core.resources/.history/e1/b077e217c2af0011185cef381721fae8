	/**
	 * Create the frame.
	 */
	public VentanaPrincipal(Empresa empresa) {
		setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
		setBounds(100, 100, 907, 635);
		this.contentPane = new JPanel();
		this.contentPane.setBorder(new EmptyBorder(5, 5, 5, 5));
		this.contentPane.setLayout(new BorderLayout(0, 0));
		setContentPane(this.contentPane);
		
		panelAcciones = new JPanel();
		contentPane.add(panelAcciones, BorderLayout.WEST);
		
		panelCreacion = new JPanel();
		panelAcciones.add(panelCreacion);
		panelCreacion.setLayout(new GridLayout(0, 1, 0, 0));
		
		btnCrearChofer = new JButton("Crear Chofer");
		btnCrearChofer.addActionListener(new ActionListener() {
			public void actionPerformed(ActionEvent arg0) {
				DialogAltaChofer dialog = new DialogAltaChofer(VentanaPrincipal.this, empresa);
		        dialog.setVisible(true);
		        
		        actualizarListaChoferes();
			}
		});
		panelCreacion.add(btnCrearChofer);
		
		btnCrearColectivo = new JButton("Crear Colectivo");
		btnCrearColectivo.addActionListener(new ActionListener() {
			public void actionPerformed(ActionEvent arg0) {
				DialogAltaColectivo dialog = new DialogAltaColectivo(VentanaPrincipal.this,empresa);
				dialog.setVisible(true);
				actualizarListaVehiculos();
			}
		});
		panelCreacion.add(btnCrearColectivo);
		
		btnCrearCamion = new JButton("Crear Camion");
		btnCrearCamion.addActionListener(new ActionListener() {
			public void actionPerformed(ActionEvent e) {
				DialogAltaCamion dialog = new DialogAltaCamion(VentanaPrincipal.this,empresa);
				dialog.setVisible(true);
				actualizarListaVehiculos();
			}
		});
		panelCreacion.add(btnCrearCamion);
		
		btnCrearAcoplado = new JButton("Crear Acoplado");
		btnCrearAcoplado.addActionListener(new ActionListener() {
			public void actionPerformed(ActionEvent e) {
				DialogAltaAcoplado dialog = new DialogAltaAcoplado(VentanaPrincipal.this,empresa);
				dialog.setVisible(true);
				actualizarListaAcoplados();
			}
		});
		panelCreacion.add(btnCrearAcoplado);
		
		panelChoferes = new JPanel();
		contentPane.add(panelChoferes, BorderLayout.CENTER);
		
		listChoferes = new JList<Chofer>();
		panelChoferes.add(listChoferes);
		
		panelVehiculos = new JPanel();
		contentPane.add(panelVehiculos, BorderLayout.EAST);
		panelVehiculos.setLayout(new GridLayout(0, 1, 0, 0));
		
		listVehiculos = new JList<Vehiculo>();
		panelVehiculos.add(listVehiculos);
		
		listAcoplados = new JList<Acoplado>();
		panelVehiculos.add(listAcoplados);
		
		this.modeloChoferes = new DefaultListModel<Chofer>();
		this.listChoferes.setModel(modeloChoferes);
		this.modeloVehiculo = new DefaultListModel<Vehiculo>();
		this.listVehiculos.setModel(modeloVehiculo);
		this.modeloAcoplado = new DefaultListModel<Acoplado>();
		this.listAcoplados.setModel(modeloAcoplado);
	}

	protected void actualizarListaAcoplados() {
		this.modeloAcoplado.clear();
		Iterator<Acoplado> it = this.empresa.getAcoplados().iterator();
		while (it.hasNext())
			this.modeloAcoplado.addElement(it.next());
		this.repaint();
	}

	protected void actualizarListaVehiculos() {
		this.modeloVehiculo.clear();
		Iterator<Vehiculo> it = this.empresa.getVehiculos().iterator();
		while (it.hasNext())
			this.modeloVehiculo.addElement(it.next());
		this.repaint();
		
	}

	protected void actualizarListaChoferes() {
		this.modeloChoferes.clear();
		Iterator<Chofer> it = this.empresa.getChoferes().iterator();
		
		while (it.hasNext())
			this.modeloChoferes.addElement(it.next());
		this.repaint();
		
	}

}
