	protected void actualizarListaAcoplados() {
		this.modeloAcoplado.clear();
		Iterator<Acoplado> it = this.empresa.getAcoplados().iterator();
		while (it.hasNext())
			this.modeloAcoplado.addElement(it.next());
		this.repaint();
	}

	protected void actualizarListaVehiculos() {
		this.modeloVehiculo.clear();
		Iterator<Vehiculo> it = this.empresa.getVehiculos().iterator();
		while (it.hasNext())
			this.modeloVehiculo.addElement(it.next());
		this.repaint();
		
	}

	protected void actualizarListaChoferes() {
		this.modeloChoferes.clear();
		Iterator<Chofer> it = this.empresa.getChoferes().iterator();
		
		while (it.hasNext())
			this.modeloChoferes.addElement(it.next());
		this.repaint();
		
	}

	public void actionPerformed(ActionEvent e) {
		if (e.getActionCommand().equals("Vincular")) this.vincular();
		else if (e.getActionCommand().equals("Desvincular")) this.desvincular();
		else if (e.getActionCommand().equals("Enganchar")) this.enganchar();
		else if (e.getActionCommand().equals("Desenganchar")) this.desenganchar();
		else if (e.getActionCommand().equals("Crear Chofer")) this.altaChofer();
		else if (e.getActionCommand().equals("Crear Colectivo")) this.altaColectivo();
		else if (e.getActionCommand().equals("Crear Camion")) this.altaCamion();
		else if (e.getActionCommand().equals("Crear Acoplado")) this.altaAcoplado();
		
		this.actualizarListaChoferes();
	    this.actualizarListaVehiculos();
	    this.actualizarListaAcoplados();
	}

