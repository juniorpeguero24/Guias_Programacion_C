	private void desvincular() {
		Chofer chofer = this.listChoferes.getSelectedValue();
		Vehiculo veh = this.listVehiculos.getSelectedValue();
		
		if (chofer != null && veh != null) {
			if (empresa.vincularChoferVehiculo(chofer, veh))
				this.textAreaDetalles.append("Se vinculo con exito.\n");
			else
				this.textAreaDetalles.append("No se pudo vincular.\n");		
		}
	}

	private void vincular() {
		Chofer chofer = this.listChoferes.getSelectedValue();
		Vehiculo veh = this.listVehiculos.getSelectedValue();
		
		if (chofer != null && veh != null) {
