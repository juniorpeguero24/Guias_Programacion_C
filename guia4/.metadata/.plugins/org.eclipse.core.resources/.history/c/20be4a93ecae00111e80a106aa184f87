	public void actionPerformed(ActionEvent arg0) {
		if (arg0.getActionCommand().equals("Crear"))
			try {
				this.crearCuenta();
			} catch (Exception e) {
				e.printStackTrace();
			}
		else if (arg0.getActionCommand().equals("Depositar")) this.depositarMonto();
		else if (arg0.getActionCommand().equals("Extraer")) this.extraerMonto();
		
		this.actualizarLista();
	}

	private void actualizarLista() {
		this.modeloLista.clear();
		Iterator<CuentaBancaria> it = this.banco.getCuentas().iterator();
		
		while (it.hasNext())
			this.modeloLista.addElement(it.next());
		this.repaint();
	}

	private void extraerMonto() {
		double monto= Double.parseDouble(textFieldMonto.getText().trim());
		CuentaBancaria cuenta = this.list_1.getSelectedValue();
		
		cuenta.extraer(monto); 
	}

	private void depositarMonto() {
		double monto= Double.parseDouble(textFieldMonto.getText().trim());
		CuentaBancaria cuenta = this.list_1.getSelectedValue();
		
		cuenta.depositar(monto);
	}

	private void crearCuenta() throws Exception {
		String titular = textFieldTitular.getText().trim();
		String tipo= (String) comboBoxTipoCuenta.getSelectedItem();
		CuentaBancaria cuenta=null;
		
		if ("Caja de Ahorro".equals(tipo)) 
			 cuenta = new CajaDeAhorro(titular);
		else 
			if ("Cuenta Corriente".equals(tipo)) { 
				String text= textFieldTopeDes.getText().trim();
				double tope = Double.parseDouble(text);
				cuenta = new CuentaCorriente(titular,tope);
			}else
				if ("Cuenta Universitaria".equals(tipo))
					cuenta = new CuentaUniversitaria(titular);
		if (cuenta != null) {
			this.textAreaDetalle.append("Se creo con exito la cuenta a nombre de "+titular);
			this.modeloLista.addElement(cuenta);
			this.banco.agregarCuenta(cuenta);
		}
	}		
			
