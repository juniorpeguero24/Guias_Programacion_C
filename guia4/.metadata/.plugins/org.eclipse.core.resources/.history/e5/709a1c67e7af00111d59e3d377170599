	public void actionPerformed(ActionEvent arg0) {
		String cmd = arg0.getActionCommand();
		
		if ("Atacar".equals(cmd)) this.atacar();
		else if ("Arquero".equals(cmd) || "Guerrero".equals(cmd) || "Caballero".equals(cmd)) this.crearPersonaje(cmd);
		else if ("Mover".equals(cmd)) this.mover();
	}

	private void mover() {
		Personaje p1 = this.listL1.getSelectedValue();
		Personaje p2 = this.listL2.getSelectedValue();
		Personaje obj;
		
		if (p1 == null && p2 == null)
			this.textAreaDetalles.append("Debe seleccionar un personaje.\n");
		else
			if (p1 != null && p2 != null)
				this.textAreaDetalles.append("Debe seleccionar un personaje.\n");
			else{
				if (p1 != null)
					obj = p1;
				else
					obj = p2;
				double x = Double.parseDouble(this.textX.getText().trim());
				double y = Double.parseDouble(this.textY.getText().trim());
				obj.getPosicion().incrementaPos(x, y);
				
			}
	}

	private void atacar() {
		Personaje p1 = this.listL1.getSelectedValue();
		Personaje p2 = this.listL2.getSelectedValue();
		
		if (p1 != null && p2 != null && p1 != p2) {
			if (p1.ataca(p2))
				this.textAreaDetalles.append(p1.getNombre()+" ataco con exito a "+p2.getNombre()+".\n");
			else
				this.textAreaDetalles.append(p1.getNombre()+" no pudo realizar el ataque.\n");
			this.listL1.repaint();
			this.listL2.repaint();
		}else
			this.textAreaDetalles.append("Seleccione personajes distintos en ambas listas.\n");
	}

	private void crearPersonaje(String cmd) {
		String nombre = this.textNombre.getText().trim();
		
		if (nombre.isEmpty())
			JOptionPane.showMessageDialog(this, "Debe ingresar el nombre", "Aviso", JOptionPane.WARNING_MESSAGE);
		else 
			try {
				Posicion pos = new Posicion(0,0);
				Personaje nuevo = PersonajeFactory.crearPersonaje(cmd, nombre, pos);
				this.modeloPersonaje.addElement(nuevo);
				this.textAreaDetalles.append(cmd+" "+nombre+" creado con exito.\n");
				this.textNombre.setText("");
			}catch (Exception e) {
				JOptionPane.showConfirmDialog(this, e.getMessage(), "Error", JOptionPane.ERROR_MESSAGE);
			}
	}

