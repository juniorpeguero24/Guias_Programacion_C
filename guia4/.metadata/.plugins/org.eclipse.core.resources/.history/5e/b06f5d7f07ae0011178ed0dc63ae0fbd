package paquete;

public abstract class Colectivo extends Vehiculo{
	protected int cantidadPasajeros;
	
	/**Constructor de Colectivo
	 * 
	 * <b>pre:<\b> igual que vehiculo pero se agrega cantidad de pasajeros mayor a cero
	 * <b>post:<\b> creado el colectivo con su cantidad de pasajeros
	 * 
	 * @param modelo
	 * @param cantidadPasajeros
	 * @throws Exception si cantidad de pasajeros es menor o igual a cero
	 */
	public Colectivo(String modelo,int cantidadPasajeros) throws Exception {
		super(modelo);
		if (cantidadPasajeros <= 0)
			throw new Exception("Cantidad de Pasajeros invalida.");
	}

	@Override
	public boolean aceptoChofer(Chofer c) {
		return false;
	}
	
	
	
}
