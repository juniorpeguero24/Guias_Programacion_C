package paquete;

public class AutomovilAutomatico extends Automovil{
	
	public AutomovilAutomatico(String patente,double velmax) {
		super(patente,velmax);
	}
	
	public AutomovilAutomatico(String patente) {
		this(patente,160.0);
	}

	@Override
	public void acelerar(double vel) {
		if (vel>=0) {
			if ((vel+velocidad) < velocidadMaxima) {
				velocidad+=vel;
				if (velocidad > 90)
					setMarcha(5);
				else
					if (velocidad > 50)
						setMarcha(4);
					else
						if (velocidad > 35)
							setMarcha(3);
						else 
							if (velocidad > 10)
								setMarcha(2);
							else
								setMarcha(1);
			}
		}
	}

	@Override
	public void frenar(double vel) {
		if (vel>=0) {
			if ((velocidad-vel) > 0 ) {
				velocidad+=vel;
				if (velocidad > 90)
					setMarcha(5);
				else
					if (velocidad > 50)
						setMarcha(4);
					else
						if (velocidad > 35)
							setMarcha(3);
						else 
							if (velocidad > 10)
								setMarcha(2);
							else
								setMarcha(1);
			}
		}
	}
	
	
}
