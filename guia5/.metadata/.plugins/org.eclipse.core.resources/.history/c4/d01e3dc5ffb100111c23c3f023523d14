package paquete;

public class Juguetero extends Artesano{

	public Juguetero(String nombre) {
		super(nombre);
	}

	@Override
	public String conMadera(Material mat) {
		return this.nombre+" fabrico un muñequito de "+mat;
	}

	@Override
	public String conMetal(Material mat) {
		return "fabrico un autito";
	}

	@Override
	public String toString() {
		return "Juguetero "+super.toString();
	}
}
