package modelo;

import interfaces.Prestable;

public class Libro extends Padre implements Prestable{
	public boolean prestado;
	
	public Libro(String codigo, String titulo, String anioDePublicacion) {
		super(codigo, titulo, anioDePublicacion);
		this.prestado=false;
	}

	@Override
	public void prestar() {
		this.prestado=false;
	}

	@Override
	public void devolver() {
		this.prestado=null;
	}

	@Override
	public boolean isPrestado() {
		return this.prestado;
	}

}
