package paquete;

public class Juguetero extends Artesano{

	public Juguetero(String nombre) {
		super(nombre);
	}

	@Override
	public String conMadera(Material mat) {
		return "Fabrico un muñequito";
	}

	@Override
	public String conMetal(Material mat) {
		return super.conMetal(mat);
	}

	@Override
	public String trabajar(Material mat) {
		return super.trabajar(mat);
	}

	@Override
	public String getNombre() {
		return super.getNombre();
	}

	
}
