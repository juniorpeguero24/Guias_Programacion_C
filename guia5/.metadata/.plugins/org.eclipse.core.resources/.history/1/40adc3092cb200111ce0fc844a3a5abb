package paquete;

public class Mago extends Personaje {

	@Override
	protected double getArmadura() {
		return 500;
	}

	@Override
	protected double getAtaqueDistante() {
		return 70;
	}

	@Override
	protected double getAtaqueCorto() {
		return 50;
	}

	@Override
	protected Personaje eligeAdversario() {
		Mazo m = Mazo.getInstancia();
		Personaje p=m.obtenerAdversarioAlAzar(this);
		if (p != null)
			return p;
		return null;
	}

}
