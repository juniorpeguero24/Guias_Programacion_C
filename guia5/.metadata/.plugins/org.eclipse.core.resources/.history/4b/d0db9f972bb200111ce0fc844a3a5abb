package paquete;

public class PersonajeFactory {
	public Personaje getPersonaje(String tipoPersonaje) {
		switch (tipoPersonaje){
			case "Mago":
				return new Mago();
			case "Elfo":
				return new Elfo();
			case "Hechicera":
				return new Hechicera();
			case "Dragon":
				return new Dragon();
			case "Guerrero":
				return new Guerrero();
		}
		return null;
	}
}
