package modelo;

public abstract class Padre {
	protected String codigo,titulo,anioDePublicacion;

	public Padre(String codigo, String titulo, String anioDePublicacion) {
		super();
		this.codigo = codigo;
		this.titulo = titulo;
		this.anioDePublicacion = anioDePublicacion;
	}

	public Padre() {}

	public String getCodigo() {
		return codigo;
	}

	public String getTitulo() {
		return titulo;
	}

	public String getAnioDePublicacion() {
		return anioDePublicacion;
	}

	@Override
	public String toString() {
		return "[codigo=" + codigo + ", titulo=" + titulo + ", anioDePublicacion=" + anioDePublicacion + "]";
	}
	
	
}
