package paquete;

public class Metal extends Material {
	protected String nombre;

	public Metal(String color, String nombre) {
		super(color);
		this.nombre = nombre;
	}

	public String getNombre() {
		return nombre;
	}

	@Override
	public String toString() {
		return "Metal nombre=" + nombre + " "+super.toString();
	}

	@Override
	protected String recibir(Artesano artesano) {
		return artesano.conMetal(this);
	}
}
